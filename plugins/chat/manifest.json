{
  "id": "chat",
  "name": "P2P Chat",
  "version": "0.1.0",
  "kind": "generic",
  "entry": "./dist/index.js",
  "permissions": [
    "network:skill:chat.receiveMessage",
    "network:public:chat.receiveMessage",
    "network:http:chat.sendMessage",
    "network:http:chat.listThreads",
    "network:http:chat.getThread",
    "storage:read:contacts",
    "hooks:on:tasks:taskUpdated"
  ],
  "exposedEvents": ["chat:messageReceived"]
}
