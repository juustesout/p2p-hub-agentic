{
  "id": "peersite",
  "name": "PeerSite",
  "version": "0.1.0",
  "kind": "generic",
  "entry": "./dist/index.js",
  "permissions": [
    "network:skill:peersite.status",
    "network:skill:peersite.fetchAsset",
    "network:skill:peersite.signAuthChallenge",
    "network:skill:peersite.requestAccess",
    "network:public:peersite.status",
    "network:public:peersite.signAuthChallenge",
    "network:public:peersite.requestAccess",
    "network:http:peersite.setSiteRoot",
    "network:http:peersite.setAcceptIncomingRequests"
  ]
}
