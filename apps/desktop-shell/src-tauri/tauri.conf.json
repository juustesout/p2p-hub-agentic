{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2p-hub-shell",
  "version": "0.1.0",
  "identifier": "dev.p2phub.shell",
  "build": {
    "beforeDevCommand": "npm run ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "p2p-hub Shell",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
