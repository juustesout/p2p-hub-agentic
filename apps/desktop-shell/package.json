{
  "name": "@p2p-hub/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows 11-inspired desktop shell for the p2p-hub P2P network",
  "scripts": {
    "dev": "npm run build:core && concurrently -k -n core,ui -c cyan,magenta \"npm run server\" \"npm run ui\"",
    "build:core": "npm run build --prefix ../..",
    "server": "node ../core-server/dist/index.js",
    "ui": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "license": "MIT"
}
